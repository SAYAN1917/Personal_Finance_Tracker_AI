# Personal Finance Tracker - configuration template.
# Copy to .env (or set as real env vars / systemd EnvironmentFile) and fill in.
# Production REQUIRES these to be set - the app fails to boot if they're
# missing or still placeholders (FINANCE_ENV=prod).

# dev | prod. prod turns on fail-fast secret validation.
FINANCE_ENV=dev

# --- Database ---
# SQLite (dev default):
#   DATABASE_URL=sqlite:////workspace/service/finance.db
# Postgres (production):
#   DATABASE_URL=postgresql://finance:CHANGE_ME@localhost:5432/finance
# Schema changes are handled by Alembic: `alembic upgrade head`.

# --- Telegram bot (required for the bot process) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to the bot.
# If unset, the bot rejects EVERY user (fail closed).
ADMIN_USER_ID=

# --- Webhook auth (API) ---
# Shared secret checked on every /webhook/* call. Set a long random value.
WEBHOOK_SECRET=CHANGE_ME

# --- Optional LLM NLU lane (Section 6.3) ---
# Leave empty to use rule-based parsing only.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=
USER_LLM_MODEL=

# --- Behaviour ---
SHARED_PROMPT_THRESHOLD=500
ASK_EVERYTHING=false
QUIET_HOURS_START=23
QUIET_HOURS_END=7

# --- Production hardening ---
# Requests per minute allowed per webhook caller; 0 disables (dev default).
RATE_LIMIT_PER_MIN=120
# Write rotating logs here (empty = stdout only).
LOG_DIR=/var/log/finance
